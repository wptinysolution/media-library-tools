{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "clean": "rimraf dist languages",
    "make-pot": "npm run clean && wp i18n make-pot . languages/review-schema.pot --exclude=node_modules,assets,dist,src,vendor",
    "package": "npm run build && npm run make-pot && cross-env NODE_ENV=package node build.js",
    "zip": "npm run build && npm run make-pot && cross-env NODE_ENV=zip node build.js"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.1",
    "zustand": "^5.0.8",
    "@ant-design/icons": "^5.3.7",
    "antd": "^5.20.5",
    "papaparse": "^5.5.2",
    "toastr": "^2.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.1.2",
    "archiver": "^7.0.1",
    "cli-color": "^2.0.4",
    "cross-env": "^10.1.0",
    "emojic": "^1.1.18",
    "fs-extra": "^11.3.2",
    "rimraf": "^6.1.2",
    "sass-embedded": "^1.90.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.1.4"
  }
}
